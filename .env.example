# Hex private key for deploying to Polkadot Hub TestNet.
# Never commit a real private key.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Optional override. Defaults to the public Polkadot Hub TestNet RPC.
POLKADOT_TESTNET_RPC=https://services.polkadothub-rpc.com/testnet

# Used by scripts/verify-sample-proof.ts after deployment.
# Also used by scripts/call-addition-viem.ts.
ADDITION_APP_ADDRESS=0xDEPLOYED_ADDITION_PROOF_APP
