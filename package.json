{
  "name": "zk-prac",
  "version": "0.1.0",
  "private": true,
  "description": "Circom Groth16 addition proof with Hardhat deployment targets for Polkadot EVM and PVM.",
  "scripts": {
    "compile": "hardhat compile",
    "compile:pvm": "hardhat compile --config hardhat.pvm.config.ts --network polkadotPvmTestnet",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "deploy:local": "hardhat run scripts/deploy-addition.ts",
    "deploy:polkadot:evm": "hardhat run scripts/deploy-addition.ts --network polkadotTestnet",
    "deploy:polkadot:pvm": "hardhat ignition deploy ignition/modules/AdditionProof.ts --config hardhat.pvm.config.ts --network polkadotPvmTestnet",
    "call:verify:viem": "tsx scripts/call-addition-viem.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.2",
    "@nomicfoundation/hardhat-ignition": "^0.15.14",
    "@nomicfoundation/hardhat-verify": "^2.1.0",
    "@parity/hardhat-polkadot": "^0.3.0",
    "@parity/resolc": "^1.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0",
    "hardhat": "^2.27.1",
    "snarkjs": "^0.7.5",
    "solc": "0.8.28",
    "tsx": "^4.21.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "viem": "^2.40.3"
  }
}
