{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "mocha"],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "hardhat.config.ts",
    "hardhat.pvm.config.ts",
    "ignition/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ]
}
